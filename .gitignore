# ===== Docker (volumes locais, se algum dia montados em ./) =====
/pgdata/
# Documentação inteira (fontes .md, ADRs, baterias, PDFs gerados) — local, não versionar.
# Desde 2026-08-31 TUDO vive em docs/; a raiz tem só o README.md do repositório.
docs/
# Resíduo do layout antigo, em que os canônicos ficavam soltos na raiz. Mantido para não
# reaparecerem num checkout velho.
/FitJourney_*.pdf
/FitJourney_*.md
# mídia de exercícios (963 mp4 + 963 png, ~460MB) — local, servida pelo Ktor em /media; nunca no git
/gifs_exercicios/
# catálogo-fonte dos exercícios (~1.6MB) — fonte da V28; embutida na migration, não versionar o json
catalogo.json
# artefato dos geradores de PDF (docs/ e tools/ rodam Python)
__pycache__/
*.pyc
# tooling local de curadoria (scripts Python + planilhas) — nao versionado
/tools/
# insumo morto do scraping; o catalogo vem das migrations (V28+)
/exercises.csv
# fotos de check-in (fatia B) — DADO DE USUÁRIO. Nunca no git, e o backup é outro assunto:
# diferente de gifs_exercicios/, isto não se regenera.
#
# SEM a barra inicial de propósito: `/uploads/` só pegaria a raiz, e num boot com working-dir em
# `server/` a pasta nasce em `server/uploads`. Já aconteceu. Sem âncora, pega em qualquer nível.
uploads/
