-- Flag do onboarding (tabela `onboarding_cache`, linha única id = 0).
-- Schema: 1.sqm. Chaveada por uid para não vazar entre contas.

selectOnboarding:
SELECT uid, onboardingCompleted FROM onboarding_cache WHERE id = 0;

upsertOnboarding:
INSERT OR REPLACE INTO onboarding_cache(id, uid, onboardingCompleted) VALUES (0, ?, ?);

clearOnboarding:
DELETE FROM onboarding_cache;
