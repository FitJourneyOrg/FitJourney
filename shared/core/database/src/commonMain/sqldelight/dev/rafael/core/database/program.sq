-- Programas e agenda (tabelas `program` e `program_schedule`).
-- Schema: 2.sqm. [REGRA] toda query filtra por uid.

-- ---------- escrita (sync) ----------

salvarPrograma:
INSERT OR REPLACE INTO program(
    id, uid, name, origin, daysPerWeek, split, rationale,
    locked, durationWeeks, startedAt, currentWeek, updatedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

salvarAgenda:
INSERT OR REPLACE INTO program_schedule(programId, workoutId, uid, dayOfWeek)
VALUES (?, ?, ?, ?);

-- Limpeza antes de regravar o sync: o que não vier na resposta some (evita órfão de
-- programa excluído em outro dispositivo).
limparProgramas:
DELETE FROM program WHERE uid = ?;

-- Limpeza que PRESERVA o que está na fila do outbox (ARCH #30, B.3).
-- O GET /programs devolve a verdade do SERVIDOR, e o servidor ainda não sabe do que foi
-- criado offline. Sem esta exceção, o primeiro sync apagaria o treino/programa recém-criado
-- e o usuário veria sumir da tela — sem erro nenhum, que é o pior tipo de perda de dado.
limparProgramasExceto:
DELETE FROM program WHERE uid = ? AND id NOT IN ?;

limparAgenda:
DELETE FROM program_schedule WHERE uid = ?;

limparAgendaExceto:
DELETE FROM program_schedule WHERE uid = ? AND programId NOT IN ?;

-- ---------- leitura ----------

observarProgramas:
SELECT * FROM program WHERE uid = ? ORDER BY updatedAt DESC;

observarPrograma:
SELECT * FROM program WHERE id = ? AND uid = ?;

agendaDoPrograma:
SELECT workoutId, dayOfWeek FROM program_schedule WHERE programId = ? AND uid = ?;

-- O TREINO DE HOJE: antes a Home baixava todos os programas e filtrava em Kotlin.
observarTreinoDoDia:
SELECT w.id, w.name, w.exerciseCount, w.locked, p.id AS programId, p.name AS programName,
       p.currentWeek, p.durationWeeks
FROM program_schedule s
JOIN workout w ON w.id = s.workoutId
JOIN program p ON p.id = s.programId
WHERE s.uid = ? AND s.dayOfWeek = ?
LIMIT 1;

contarProgramas:
SELECT COUNT(*) FROM program WHERE uid = ?;

-- ---------- escrita OTIMISTA (B.3) ----------

renomearPrograma:
UPDATE program SET name = ?, updatedAt = ? WHERE id = ? AND uid = ?;

excluirPrograma:
DELETE FROM program WHERE id = ? AND uid = ?;

limparAgendaDoPrograma:
DELETE FROM program_schedule WHERE programId = ? AND uid = ?;

excluirTreinosDoPrograma:
DELETE FROM workout WHERE programId = ? AND uid = ?;

-- Excluir treino tem de tirá-lo da agenda também, senão sobra entrada apontando p/ nada.
excluirDaAgenda:
DELETE FROM program_schedule WHERE workoutId = ? AND uid = ?;
