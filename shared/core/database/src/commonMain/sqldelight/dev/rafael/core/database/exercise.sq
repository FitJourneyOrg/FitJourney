-- Catálogo de exercícios (tabela `exercise`).
-- Schema: 1.sqm (nesta pasta). Aqui só ficam as QUERIES.

selectByIds:
SELECT id, name, thumbRef FROM exercise WHERE id IN ?;

-- Detalhe de UM exercício. Antes o cliente baixava o catálogo inteiro (965 linhas)
-- e filtrava em memória para abrir uma tela de detalhe.
selectById:
SELECT * FROM exercise WHERE id = ?;

selectAll:
SELECT * FROM exercise;

selectByCategory:
SELECT * FROM exercise WHERE category = ?;

insertOrReplace:
INSERT OR REPLACE INTO exercise(id, name, category, description, videoRef, thumbRef)
VALUES (?, ?, ?, ?, ?, ?);

deleteAll:
DELETE FROM exercise;

countAll:
SELECT count(*) FROM exercise;
