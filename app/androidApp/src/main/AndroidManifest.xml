<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- vibração ao fim do descanso entre séries (Fase 5) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Declaradas explicitamente: hoje elas chegam por merge do manifesto do Firebase/WorkManager,
         o que significa que remover uma dependência tiraria a permissão sem aviso. Ambas são
         normais (concedidas na instalação, sem diálogo). ACCESS_NETWORK_STATE é o que permite
         distinguir "você está offline" de "o servidor não respondeu" (ver ui/ErrorUi.kt). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Check-in (Fase 6, fatia B). Ambas são de RUNTIME: pedidas na hora, e negá-las impede o
         check-in apenas nos grupos que exigem a regra correspondente (5.3). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- COARSE é o PADRÃO; FINE é opcional e só é PEDIDA quando a pessoa escolhe "exatamente aqui".
         A 5.2 arredonda a coordenada para 2 casas (~1 km) e o invariante diz que a exata NUNCA é
         gravada — isso vale nos dois casos. O que a precisão fina muda é apenas o RÓTULO sugerido:
         com ~1-3 km o Geocoder devolveria uma rua que pode estar a um quilômetro da certa, e um
         texto que parece exato e está errado é pior que nenhum.
         Declarar as duas é requisito do Android para poder pedir a fina depois; a que o app
         solicita ao abrir a tela é a COARSE. Em escolha de privacidade o padrão pesa mais que a
         opção, e o padrão aqui protege. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- `required=false`: emulador e tablets sem câmera continuam instalando o app. Quem não tem
         câmera simplesmente não entra em desafio que exige foto — o app inteiro não some da Play
         Store por causa de uma regra opcional de grupo. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".FitJourneyApp"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:exported="true"
            android:name="dev.rafael.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>