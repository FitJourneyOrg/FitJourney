<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- vibração ao fim do descanso entre séries (Fase 5) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Declaradas explicitamente: hoje elas chegam por merge do manifesto do Firebase/WorkManager,
         o que significa que remover uma dependência tiraria a permissão sem aviso. Ambas são
         normais (concedidas na instalação, sem diálogo). ACCESS_NETWORK_STATE é o que permite
         distinguir "você está offline" de "o servidor não respondeu" (ver ui/ErrorUi.kt). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Check-in (Fase 6, fatia B). Ambas são de RUNTIME: pedidas na hora, e negá-las impede o
         check-in apenas nos grupos que exigem a regra correspondente (5.3). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- COARSE é o PADRÃO; FINE é opcional e só é PEDIDA quando a pessoa escolhe "exatamente aqui".
         A 5.2 arredonda a coordenada para 2 casas (~1 km) e o invariante diz que a exata NUNCA é
         gravada — isso vale nos dois casos. O que a precisão fina muda é apenas o RÓTULO sugerido:
         com ~1-3 km o Geocoder devolveria uma rua que pode estar a um quilômetro da certa, e um
         texto que parece exato e está errado é pior que nenhum.
         Declarar as duas é requisito do Android para poder pedir a fina depois; a que o app
         solicita ao abrir a tela é a COARSE. Em escolha de privacidade o padrão pesa mais que a
         opção, e o padrão aqui protege. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      Push (F.1). Só é PEDIDA em runtime a partir do Android 13 (API 33); abaixo disso a
      notificação é permitida por padrão.

      Negar não quebra nada: a notificação continua gravada no servidor (V42) e a central a
      mostra quando o app abre. O push é o aviso, não a verdade.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- `required=false`: emulador e tablets sem câmera continuam instalando o app. Quem não tem
         câmera simplesmente não entra em desafio que exige foto — o app inteiro não some da Play
         Store por causa de uma regra opcional de grupo. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      BACKUP DESLIGADO.

      Tudo que o app guarda localmente é CÓPIA do servidor: catálogo de exercícios, programas,
      treinos, stats, grupos. Restaurar isso não devolve nada que o primeiro sync não devolveria
      — e devolve DADO VELHO, que o app passa a tratar como verdade.

      Não é hipótese. Depois de converter as miniaturas para WebP, o aparelho continuou pedindo
      `.png` mesmo desinstalado e reinstalado: o Android havia restaurado o banco da nuvem com as
      refs antigas, e o catálogo nem chegou a ser sincronizado — não havia um único
      `GET /exercises` no log do servidor.

      Efeito colateral bom: "desinstalar para testar limpo" volta a significar o que promete, e
      isso vale para toda bateria manual daqui pra frente.

      O que NÃO se perde: nada que exista só no aparelho. Token e dado sensível ficam no
      Keystore ([REGRA] de segurança) e nunca estiveram no backup; a fila do outbox é escrita
      pendente, e se ela existir na hora da desinstalação já se perdeu de qualquer forma.

      `dataExtractionRules` cobre a API 31+, onde `allowBackup` sozinho não desliga a
      transferência direta entre aparelhos.
    -->
    <application
        android:name=".FitJourneyApp"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/regras_de_extracao"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:exported="true"
            android:name="dev.rafael.app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Recebe o push (F.1). `exported="false"`: só o FCM o invoca, via o sistema.
        -->
        <service
            android:name="dev.rafael.app.push.FitJourneyMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>